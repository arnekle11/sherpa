# Copy to .env, then: chmod 600 .env   (never commit it). docker compose reads it; each container gets only
# the variables it needs. Put values containing "$" in single quotes. Apply changes with: docker compose up -d
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
SHERPA_TELEGRAM_TOKEN=
SHERPA_TELEGRAM_CHAT_ID=
# Time zone for logs, the web UI and statistics
TZ=Europe/Ljubljana
# Web UI (port 8080): anyone on the LAN can view; this password is needed to change settings.
# Leave empty for a read-only site. Use a long random value; it travels over plain HTTP on the LAN.
SHERPA_WEB_PASSWORD=
# Optional but recommended: dead-man's switch. SHERPA pings this URL every deadman_interval_s while
# its poll loop is healthy; the external monitor (healthchecks.io, Uptime Kuma "push", ...) alerts you
# when the pings STOP - which catches a dead VM/service that cannot send Telegram alerts itself.
SHERPA_DEADMAN_URL=
# Optional: listen only on this address (e.g. the VM's LAN IP; Docker-published ports bypass ufw) / other port
SHERPA_WEB_BIND=
SHERPA_WEB_PORT=8080
